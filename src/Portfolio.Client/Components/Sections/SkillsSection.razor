@inherits LocalizedComponentBase

@* Технологии: строки с волосяными линиями, без плашек и скруглений. *@

<section id="skills" class="section section--black">
    <div class="container-narrow">
        <SectionHeader Label="@T.SkillsLabel" Title="@T.SkillsTitle" Subtitle="@T.SkillsSubtitle" />

        @if (Categories.Count == 0)
        {
            <LoadingBlock Text="@T.SkillsUnavailable" />
        }
        else
        {
            <ul class="skills-list">
                @foreach (var category in Categories)
                {
                    <li class="skill-row reveal">
                        <h3 class="skill-row__name">@category.Name</h3>
                        <ul class="chips">
                            @foreach (var skill in category.Skills)
                            {
                                <li class="chip">@skill</li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SkillCategoryDto> Categories { get; set; } = [];
}

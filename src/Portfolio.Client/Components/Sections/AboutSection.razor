@inherits LocalizedComponentBase

@* Манифест: одно крупное утверждение, под ним подробности и цифры. *@

<section id="about" class="section section--zinc manifesto">
    <div class="container-narrow manifesto__inner">
        <span class="label-mono reveal">@T.AboutLabel</span>

        <p class="manifesto__lead reveal">@Lead</p>

        @if (Rest.Count > 0)
        {
            <div class="manifesto__body reveal">
                @foreach (var paragraph in Rest)
                {
                    <p>@paragraph</p>
                }
            </div>
        }

        <div class="rule manifesto__rule reveal"></div>

        <div class="about__stats">
            <div class="stat-card reveal">
                <div class="stat-card__value">@(Profile.YearsOfExperience)+</div>
                <div class="stat-card__label">@T.AboutStatYears</div>
            </div>
            <div class="stat-card reveal">
                <div class="stat-card__value">@ProjectCount</div>
                <div class="stat-card__label">@T.AboutStatProjects</div>
            </div>
            <div class="stat-card reveal">
                <div class="stat-card__value">@TechnologyCount</div>
                <div class="stat-card__label">@T.AboutStatTechnologies</div>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public ProfileDto Profile { get; set; } = default!;

    [Parameter] public int ProjectCount { get; set; }

    [Parameter] public int TechnologyCount { get; set; }

    /// <summary>Текст «Обо мне» хранится строками: первая становится манифестом.</summary>
    private IReadOnlyList<string> Paragraphs =>
        Profile.About.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private string Lead => Paragraphs.Count > 0 ? Paragraphs[0] : string.Empty;

    private IReadOnlyList<string> Rest => Paragraphs.Skip(1).ToList();
}

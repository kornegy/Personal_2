@inherits LocalizedComponentBase
@inject IPortfolioApi Api

@* Финальная светлая секция: крупный призыв, форма, контакты и нижняя строка.
   Правила валидации описаны в Portfolio.Shared и проверяются ещё раз на сервере. *@

<section id="contact" class="section section--ghost">
    <div class="container-narrow">
        <div class="reveal">
            <span class="label-mono">@T.ContactLabel</span>
            <DisplayHeading Text="@T.ContactStartProject" CssClass="contact-display" />
        </div>

        <div class="contact-grid">
            <div class="reveal">
                <ul class="contact-list">
                    <li>
                        <span class="label-mono">@T.ContactFieldEmail</span>
                        <a class="contact-list__value" href="mailto:@Profile.Email">@Profile.Email</a>
                    </li>
                    @if (!string.IsNullOrWhiteSpace(Profile.Phone))
                    {
                        <li>
                            <span class="label-mono">@T.ContactPhoneLabel</span>
                            <a class="contact-list__value" href="tel:@Profile.Phone">@Profile.Phone</a>
                        </li>
                    }
                    <li>
                        <span class="label-mono">@T.ContactLocationLabel</span>
                        <span class="contact-list__value">@Profile.Location</span>
                    </li>
                </ul>
            </div>

            <div class="form-card reveal">
                <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="field">
                        <label for="contact-name">@T.ContactFieldName</label>
                        <InputText id="contact-name" @bind-Value="_model.Name" placeholder="@T.ContactPlaceholderName" autocomplete="name" />
                        <LocalizedValidation TValue="string" For="() => _model.Name" />
                    </div>

                    <div class="field">
                        <label for="contact-email">@T.ContactFieldEmail</label>
                        <InputText id="contact-email" type="email" @bind-Value="_model.Email" placeholder="@T.ContactPlaceholderEmail" autocomplete="email" />
                        <LocalizedValidation TValue="string" For="() => _model.Email" />
                    </div>

                    <div class="field">
                        <label for="contact-subject">@T.ContactFieldSubject</label>
                        <InputText id="contact-subject" @bind-Value="_model.Subject" placeholder="@T.ContactPlaceholderSubject" />
                        <LocalizedValidation TValue="string" For="() => _model.Subject" />
                    </div>

                    <div class="field">
                        <label for="contact-message">@T.ContactFieldMessage</label>
                        <InputTextArea id="contact-message" @bind-Value="_model.Message" placeholder="@T.ContactPlaceholderMessage" />
                        <LocalizedValidation TValue="string" For="() => _model.Message" />
                    </div>

                    @* Ловушка для ботов: поле скрыто и недоступно с клавиатуры. *@
                    <div class="honeypot" aria-hidden="true">
                        <label for="contact-website">@T.ContactHoneypotLabel</label>
                        <InputText id="contact-website" @bind-Value="_model.Website" tabindex="-1" autocomplete="off" />
                    </div>

                    <button type="submit" class="btn-accent" disabled="@_isSending">
                        @(_isSending ? T.ContactSending : T.ContactSubmit)
                    </button>
                </EditForm>

                @if (_result is not null)
                {
                    <div class="form-status @(_result.Success ? string.Empty : "form-status--error")" role="status">
                        @StatusText
                    </div>
                }
            </div>
        </div>

        <div class="contact-bottom">
            @if (Profile.SocialLinks.Count > 0)
            {
                <div class="social-row">
                    @foreach (var link in Profile.SocialLinks)
                    {
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Name</a>
                    }
                </div>
            }

            <span class="label-mono">© @DateTime.Now.Year @Profile.FullName · @T.ContactRights</span>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public ProfileDto Profile { get; set; } = default!;

    private ContactRequest _model = new();
    private ContactResult? _result;
    private bool _isSending;

    /// <summary>Сервер возвращает код ответа, текст подбираем по текущему языку.</summary>
    private string StatusText =>
        _result is not null && T.ContactStatus.TryGetValue(_result.Code, out var text)
            ? text
            : string.Empty;

    private async Task SubmitAsync()
    {
        _isSending = true;
        _result = null;

        try
        {
            _result = await Api.SendContactAsync(_model);

            if (_result.Success)
            {
                // Форма очищается только после успешной отправки,
                // иначе пользователь потеряет набранный текст.
                _model = new ContactRequest();
            }
        }
        finally
        {
            _isSending = false;
        }
    }
}

@inherits LocalizedComponentBase

@* Работы — единственная светлая секция в середине страницы. *@

<section id="projects" class="section section--light">
    <div class="container-narrow">
        <SectionHeader Label="@T.ProjectsLabel" Title="@T.ProjectsTitle" Subtitle="@T.ProjectsSubtitle" />

        @if (Projects.Count == 0)
        {
            <LoadingBlock Text="@T.ProjectsUnavailable" />
        }
        else
        {
            <div class="projects-grid">
                @foreach (var project in Projects)
                {
                    <ProjectCard Project="project" />
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ProjectDto> Projects { get; set; } = [];
}

@inherits LocalizedComponentBase

@* Карточка проекта: тёмная плитка на светлой секции.
   При наведении превью подъезжает, метаданные подтягиваются,
   в углу проявляется круглая кнопка со стрелкой. *@

<article class="project-card reveal">
    <div class="project-card__cover">
        @if (!string.IsNullOrWhiteSpace(Project.ImageUrl))
        {
            <img src="@Project.ImageUrl" alt="@T.ProjectPreviewAlt: @Project.Title" loading="lazy" />
        }

        @if (PrimaryLink is not null)
        {
            <span class="project-card__action" aria-hidden="true">
                <i class="bi bi-arrow-up-right"></i>
            </span>
        }
    </div>

    <div class="project-card__body">
        <h3 class="project-card__title">@Project.Title</h3>

        <div class="project-card__meta">
            @if (Project.Year is not null)
            {
                <span class="label-mono">@Project.Year</span>
            }
            <span class="label-mono">@Project.Technologies.Count @T.ProjectTechCountLabel</span>
        </div>

        <p class="project-card__summary">@Project.Summary</p>
        <p class="project-card__description">@Project.Description</p>

        <ul class="chips">
            @foreach (var technology in Project.Technologies)
            {
                <li class="chip">@technology</li>
            }
        </ul>

        @if (PrimaryLink is not null)
        {
            <div class="project-card__links">
                @if (!string.IsNullOrWhiteSpace(Project.DemoUrl))
                {
                    <a href="@Project.DemoUrl" target="_blank" rel="noopener noreferrer">@T.ProjectLinkDemo</a>
                }
                @if (!string.IsNullOrWhiteSpace(Project.SourceUrl))
                {
                    <a href="@Project.SourceUrl" target="_blank" rel="noopener noreferrer">@T.ProjectLinkSource</a>
                }
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ProjectDto Project { get; set; } = default!;

    private string? PrimaryLink =>
        !string.IsNullOrWhiteSpace(Project.DemoUrl) ? Project.DemoUrl :
        !string.IsNullOrWhiteSpace(Project.SourceUrl) ? Project.SourceUrl : null;
}
